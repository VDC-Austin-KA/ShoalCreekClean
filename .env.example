# Postgres (local, Docker, or Supabase connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shoalcreek
# true for Supabase / managed Postgres requiring TLS
DATABASE_SSL=false
# docker-compose only
POSTGRES_PASSWORD=change-me
# 32+ random chars: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-0123456789
# Public base URL (used in magic links / Stripe redirects)
APP_URL=http://localhost:3000
# Show demo credentials on the login page + simulated payments
ALPHA_MODE=true
# Optional: real Stripe test-mode checkout (otherwise payments are simulated)
STRIPE_SECRET_KEY=
# Optional: real email delivery via SMTP (otherwise emails land in the admin Outbox)
SMTP_URL=
MAIL_FROM="Shoal Creek Clean <hello@ackerworks.com>"
