# Local development secrets — copy to .dev.vars (read by `wrangler dev` and `next dev`).
# In production, set secrets with `npx wrangler secret put <NAME>`; plain vars live in wrangler.jsonc.

# 32+ random chars: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-0123456789
# Public base URL (magic links / Stripe redirects)
APP_URL=http://localhost:3000
# Show demo credentials on the login page + simulated payments
ALPHA_MODE=true
# Optional: real Stripe test-mode checkout (otherwise payments are simulated)
STRIPE_SECRET_KEY=
# Optional: real email via Resend's HTTP API (otherwise emails land in the admin Outbox)
RESEND_API_KEY=
MAIL_FROM="Shoal Creek Clean <hello@ackerworks.com>"
