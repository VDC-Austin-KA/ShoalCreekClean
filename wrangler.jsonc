// Cloudflare Workers + D1 deployment (OpenNext). See README "Deploy".
// Secrets (set with `wrangler secret put <NAME>`): SESSION_SECRET; optional STRIPE_SECRET_KEY, RESEND_API_KEY.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shoalcreek-clean",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "1a08662719e83ad25376ff159ac70027",
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": true,
  "routes": [{ "pattern": "wash.ackerworks.com", "custom_domain": true }, { "pattern": "clean.ackerworks.com", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "shoalcreek", "database_id": "5193dd2e-ae00-4ed5-8cbe-964bbc9d6997", "migrations_dir": "db" }
  ],
  "vars": {
    "APP_URL": "https://wash.ackerworks.com",
    "ALPHA_MODE": "true",
    "MAIL_FROM": "Shoal Creek Clean <hello@ackerworks.com>"
  },
  "observability": { "enabled": true }
}
