{
  "name": "shoal-creek-clean",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:setup": "node scripts/db-setup.ts",
    "db:seed": "node scripts/db-setup.ts --seed",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy:embedded": "opennextjs-cloudflare build && node scripts/embed-assets.mjs && wrangler deploy -c wrangler.embedded.jsonc"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "leaflet": "^1.9.4",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  },
  "type": "module"
}
